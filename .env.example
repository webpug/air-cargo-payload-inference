# Copy to .env and fill in; .env is git-ignored. Load with:  set -a; source .env; set +a

# Required for `ingest` over more than ~60 days per hour (GitHub API rate limit).
# Fine-grained token with *no* repository permissions (public read only) is enough.
GITHUB_TOKEN=

# Optional, not yet used by the code (see issues): AWS for S3-backed storage.
# Prefer an instance role or `aws configure --profile` over keys in this file.
AWS_PROFILE=
AWS_REGION=us-east-1
CARGO_S3_BUCKET=

# Optional, not yet used by the code: OpenSky Trino (research access must be approved first).
OPENSKY_USERNAME=
